{
  "manifest_version": 3,
  "name": "Overleaf Workshop Cookie Retriever",
  "version": "1.1",
  "description": "A Chromium extension that retrieves cookies for Overleaf Workshop VSCode extension.",
  "permissions": [
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://*.overleaf.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Overleaf Workshop Cookie Retriever"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
